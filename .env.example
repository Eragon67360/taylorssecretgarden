# Copy to .env.local and fill in. Never commit real values.

# Clerk (development instance): sign-in for Swiftter Members
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=

# Cloudinary: Tour images, videos and page backgrounds
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Supabase: Swiftter's old database. The project no longer exists, but the
# client is created at module load, so `next build` needs both set.
# Removed when #12 moves Swiftter to Neon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
