# Copy to .env.local and fill in. Never commit real values.

# Postgres: Swiftter's Members and Posts. On Vercel, the Neon integration
# injects it (with several PG*/POSTGRES_* variants the app does not read).
# Also used by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=

# Neon Auth (sign-in for Swiftter Members, docs/adr/0004): the Auth URL of the
# same Neon branch as DATABASE_URL. On Vercel, the Neon integration injects it
# (a preview gets its own branch's URL).
NEON_AUTH_BASE_URL=
# Signs the session cookies: 32+ random characters (`openssl rand -base64 48`).
# Set in Vercel for every environment and in the GitHub secrets for CI.
NEON_AUTH_COOKIE_SECRET=

# Optional: 1 serves the development styleguide (/styleguide) from a
# production build. Set by the Playwright web server and CI; never in production.
ENABLE_STYLEGUIDE=
