# Copy to .env.local and fill in. Never commit real values.

# Clerk (development instance): sign-in for Swiftter Members
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where Clerk sends a new Member right after sign-up.
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/swiftter

# Postgres: Swiftter's Members and Posts. On Vercel, the Neon integration
# injects it (with several PG*/POSTGRES_* variants the app does not read).
# Also used by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=

# Optional: 1 serves the development styleguide (/styleguide) from a
# production build. Set by the Playwright web server and CI; never in production.
ENABLE_STYLEGUIDE=

# Optional, for running the signed-in Swiftter tests locally: the dedicated
# test Member on the Clerk development instance (CI reads them from secrets).
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
