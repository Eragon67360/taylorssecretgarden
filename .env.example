# Copy to .env.local and fill in. Never commit real values.

# Postgres: Swiftter's Members and Posts. On Vercel, the Neon integration
# injects it (with several PG*/POSTGRES_* variants the app does not read).
# Also used by `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=

# Neon Auth (sign-in for Swiftter Members, docs/adr/0004): the Auth URL of the
# same Neon branch as DATABASE_URL. On Vercel, set per environment: Production
# gets the production branch's, Preview and Development the `dev` branch's
# (every preview shares `dev`; see README, Database).
NEON_AUTH_BASE_URL=
# Signs the session cookies: 32+ random characters (`openssl rand -base64 48`).
# Set in Vercel for every environment and in the GitHub secrets for CI.
# Production's value must be its own: whoever holds a copy can sign sessions.
NEON_AUTH_COOKIE_SECRET=
# Optional: `true` lets only Members with a confirmed email address write on
# Swiftter (lib/auth/email-verification.ts); off when unset. Turn it on in
# Vercel once Neon Auth's "Verify at sign-up" is on for that branch.
REQUIRE_EMAIL_VERIFICATION=

# Optional: 1 serves the development styleguide (/styleguide) from a
# production build. Set by the Playwright web server and CI; never in production.
ENABLE_STYLEGUIDE=

# AI moderation of Posts (service/moderation.ts) goes through Vercel AI
# Gateway. On Vercel it authenticates with the deployment's OIDC token, nothing
# to set. Locally, either an AI Gateway API key, or the VERCEL_OIDC_TOKEN that
# `npx vercel env pull --scope le-bon-temperament` writes (valid ~12 hours).
AI_GATEWAY_API_KEY=
# Optional: `fake` moderates without AI (marker words decide; for the
# Playwright suite and CI). Ignored on Vercel deployments.
SWIFTTER_MODERATION=

# Authorises Vercel Cron's calls to /api/cron/moderation (vercel.json: hourly,
# re-checks notes still waiting for moderation and sends owner alerts). Set in
# Vercel for Production only, where Cron runs; locally only to call the route
# by hand, with `Authorization: Bearer <value>`.
CRON_SECRET=

# Optional: owner alerts as GitHub issues (service/owner-alerts.ts): notes the
# moderation re-check gave up on, and the hourly summary of reports and
# appeals. A fine-grained personal access token limited to the repository
# Eragon67360/taylorssecretgarden, with the permission Issues: read and write,
# nothing else. Set in Vercel for Production only, as a Sensitive variable.
# Without it the alerts are only logged. The repository is public: alerts name
# notes by id, never a Member or a held note's text.
OWNER_ALERTS_GITHUB_TOKEN=
