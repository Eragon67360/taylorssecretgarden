{
	"name": "taylors-secret-garden",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
		"db:seed": "tsx --env-file-if-exists=.env.local db/seed.ts",
		"db:unseed": "tsx --env-file-if-exists=.env.local db/unseed.ts",
		"lighthouse": "lhci autorun",
		"moderation:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-moderation.ts"
	},
	"dependencies": {
		"@neondatabase/auth": "0.5.0-beta",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"ai": "^7.0.122",
		"botid": "^1.5.11",
		"cn": "^0.4.0",
		"drizzle-orm": "^0.45.3",
		"motion": "^13.4.4",
		"next": "16.3.6",
		"pg": "^8.23.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sanitize-html": "^2.17.7",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.19.0",
		"@types/pg": "^8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"postcss": "8.4.38",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
